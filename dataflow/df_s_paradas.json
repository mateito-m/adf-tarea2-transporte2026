{
	"name": "df_s_paradas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_b_paradas",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "s_dw_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(ParadaHistoricaId = upper(trim(ParadaHistoricaId)),",
				"          CodigoPublicado = upper(trim(CodigoPublicado)),",
				"          NombreParada = trim(NombreParada),",
				"          Zona = trim(Zona),",
				"          Latitud = toDecimal(toString(Latitud), 9, 6),",
				"          Longitud = toDecimal(toString(Longitud), 9, 6),",
				"          VigenciaDesde = iif(instr(VigenciaDesde, '/') > 0, toDate (VigenciaDesde, 'dd/MM/yyyy'), toDate (VigenciaDesde, 'yyyy-MM-dd')),",
				"          VigenciaHasta = iif(instr(VigenciaDesde, '/') > 0, toDate (VigenciaHasta, 'dd/MM/yyyy'), toDate (VigenciaHasta, 'yyyy-MM-dd')),",
				"          Estado = upper(trim(Estado))) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as decimal(9,6),",
				"          Longitud as decimal(9,6),",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ParadaHistoricaId,",
				"          CodigoPublicado,",
				"          NombreParada,",
				"          Zona,",
				"          Latitud,",
				"          Longitud,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}