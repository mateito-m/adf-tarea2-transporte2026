{
	"name": "df_s_vehiculos",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_b_vehiculos",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "s_dw_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(VehiculoId = trim(VehiculoId),",
				"          Placa = trim(Placa),",
				"          TipoVehiculo = upper(trim(TipoVehiculo)),",
				"          CapacidadEfectiva = toInteger(CapacidadEfectiva),",
				"          VigenciaDesde = iif(    isNull(VigenciaDesde),    toDate(null()),    iif(        instr(VigenciaDesde, '/') > 0,        toDate(VigenciaDesde, 'dd/MM/yyyy'),        iif(            length(VigenciaDesde) == 5,            addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(VigenciaDesde)),            toDate(VigenciaDesde, 'yyyy-MM-dd')        )    )),",
				"          VigenciaHasta = iif(    isNull(VigenciaHasta),    toDate(null()),    iif(        instr(VigenciaHasta, '/') > 0,        toDate(VigenciaHasta, 'dd/MM/yyyy'),        iif(            length(VigenciaHasta) == 5,            addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(VigenciaHasta)),            toDate(VigenciaHasta, 'yyyy-MM-dd')        )    )),",
				"          Estado = upper(trim(Estado))) ~> derivedColumn1",
				"derivedColumn1 derive(VehiculoId = iif(    toString(VehiculoId) == '043' ||    toString(VehiculoId) == 'V-043',    iif(        toInteger(CapacidadEfectiva) == 60,        'V-043-1',        'V-043'    ),    iif(        left(toString(VehiculoId), 2) == 'V-',        toString(VehiculoId),        concat('V-', toString(VehiculoId))    ))) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado),",
				"     Contador = count()) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as integer,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}