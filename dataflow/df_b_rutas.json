{
	"name": "df_b_rutas",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "b_csv_rutas",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "b_sql_rutas",
						"type": "DatasetReference"
					},
					"name": "sql"
				},
				{
					"dataset": {
						"referenceName": "b_xls_rutas2022",
						"type": "DatasetReference"
					},
					"name": "xls2022"
				},
				{
					"dataset": {
						"referenceName": "b_xls_rutas2023",
						"type": "DatasetReference"
					},
					"name": "xls2023"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_b_rutas",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "union1"
				},
				{
					"name": "union3"
				},
				{
					"name": "union4"
				},
				{
					"name": "union5"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cod_ruta as string,",
				"          nombre_ruta as string,",
				"          origen as string,",
				"          destino as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"          AnioFuente as integer,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql",
				"source(output(",
				"          cod_ruta as string,",
				"          nombre_ruta as string,",
				"          origen as string,",
				"          destino as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls2022",
				"source(output(",
				"          cod_ruta as string,",
				"          nombre_ruta as string,",
				"          origen as string,",
				"          destino as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls2023",
				"csv select(mapColumn(",
				"          CodigoRuta = cod_ruta,",
				"          NombreRuta = nombre_ruta,",
				"          Origen = origen,",
				"          Destino = destino,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"xls2022 select(mapColumn(",
				"          CodigoRuta = cod_ruta,",
				"          NombreRuta = nombre_ruta,",
				"          Origen = origen,",
				"          Destino = destino,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"xls2023 select(mapColumn(",
				"          CodigoRuta = cod_ruta,",
				"          NombreRuta = nombre_ruta,",
				"          Origen = origen,",
				"          Destino = destino,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select1, sql union(byName: true)~> union1",
				"select3 union(byName: true)~> union3",
				"union1, select2 union(byName: true)~> union4",
				"union4, select3 union(byName: true)~> union5",
				"union5 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}