{
	"name": "df_s_incidentes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_b_incidentes",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "s_dw_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(IncidenteId = trim(IncidenteId),",
				"          TipoIncidente = upper(trim(TipoIncidente)),",
				"          Severidad = trim(Severidad),",
				"          FechaHoraInicio = iif(\r",
				"    instr(toString(FechaHoraInicio), '1899-12-31') > 0,\r",
				"    toTimestamp(\r",
				"        concat(\r",
				"            substring(toString(FechaHoraInicio), 1, 10),\r",
				"            ' ',\r",
				"            substring(toString(FechaHoraInicio), 22, 8)\r",
				"        ),\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"    toTimestamp(FechaHoraInicio)\r",
				")\r",
				",",
				"          FechaHoraFin = iif(\r",
				"    instr(toString(FechaHoraFin), '1899-12-31') > 0,\r",
				"    toTimestamp(\r",
				"        concat(\r",
				"            substring(toString(FechaHoraFin), 1, 10),\r",
				"            ' ',\r",
				"            substring(toString(FechaHoraFin), 22, 8)\r",
				"        ),\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"    toTimestamp(FechaHoraFin)\r",
				"),",
				"          FechaHoraRegistro = toTimestamp(FechaHoraRegistro, 'yyyy-MM-dd HH:mm:ss'),",
				"          VehiculoId = iif(isNull(VehiculoId) || trim(VehiculoId) == '', toString(null()), trim(VehiculoId)),",
				"          Descripcion = trim(Descripcion)) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}