{
	"name": "df_s_rutas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_b_rutas",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "s_dw_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "aggregate2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"derivedColumn2 derive(RutaHistoricaId = iif(\r",
				"    isNull(RutaHistoricaId) || trim(RutaHistoricaId) == '',\r",
				"    toString(null()),\r",
				"    iif(\r",
				"        startsWith(upper(trim(RutaHistoricaId)), 'RUTA '),\r",
				"        iif(\r",
				"            length(trim(substring(trim(RutaHistoricaId), 6, 20))) == 1,\r",
				"            concat('RH-0', trim(substring(trim(RutaHistoricaId), 6, 20))),\r",
				"            concat('RH-', trim(substring(trim(RutaHistoricaId), 6, 20)))\r",
				"        ),\r",
				"        iif(\r",
				"            startsWith(upper(trim(RutaHistoricaId)), 'R-'),\r",
				"            concat('RH-', substring(trim(RutaHistoricaId), 3, 20)),\r",
				"            iif(\r",
				"                startsWith(upper(trim(RutaHistoricaId)), 'RH-'),\r",
				"                upper(trim(RutaHistoricaId)),\r",
				"                iif(\r",
				"                    length(trim(RutaHistoricaId)) == 2,\r",
				"                    concat('RH-', trim(RutaHistoricaId)),\r",
				"                    upper(trim(RutaHistoricaId))\r",
				"                )\r",
				"            )\r",
				"        )\r",
				"    )\r",
				"),",
				"          CodigoRuta = upper(trim(CodigoRuta)),",
				"          NombreRuta = trim(NombreRuta),",
				"          Origen = trim(Origen),",
				"          Destino = trim(Destino),",
				"          VigenciaDesde = iif(     isNull(VigenciaDesde),     toDate(null()),     iif(         instr(VigenciaDesde, '/') > 0,         toDate(VigenciaDesde, 'dd/MM/yyyy'),         iif(             length(VigenciaDesde) == 5,             addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(VigenciaDesde)),             toDate(VigenciaDesde, 'yyyy-MM-dd')         )     ) ),",
				"          VigenciaHasta = iif(     isNull(VigenciaHasta),     toDate(null()),     iif(         instr(VigenciaHasta, '/') > 0,         toDate(VigenciaHasta, 'dd/MM/yyyy'),         iif(             length(VigenciaHasta) == 5,             addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(VigenciaHasta)),             toDate(VigenciaHasta, 'yyyy-MM-dd')         )     ) ),",
				"          Estado = upper(trim(Estado))) ~> derivedColumn1",
				"source1 derive(CodigoRuta = iif(     isNull(CodigoRuta),     '',     CodigoRuta )) ~> derivedColumn2",
				"derivedColumn1 aggregate(groupBy(RutaHistoricaId),",
				"     CodigoRuta = first(CodigoRuta),",
				"          NombreRuta = first(NombreRuta),",
				"          Origen = first(Origen),",
				"          Destino = first(Destino),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"aggregate1 aggregate(groupBy(RutaHistoricaId,",
				"          CodigoRuta,",
				"          NombreRuta,",
				"          Origen,",
				"          Destino,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado),",
				"     Contador = count()) ~> aggregate2",
				"aggregate2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          RutaHistoricaId,",
				"          CodigoRuta,",
				"          NombreRuta,",
				"          Origen,",
				"          Destino,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}