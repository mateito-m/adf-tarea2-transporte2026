{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-ucb-transporte-us-13751000"
		},
		"sa_transporte_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'sa_transporte'"
		},
		"sql_dw_transporte_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'sql_dw_transporte'"
		},
		"sql_erp_transporte_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'sql_erp_transporte'"
		},
		"sa_transporte_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saucbtransporte13751000.dfs.core.windows.net/"
		},
		"sql_dw_transporte_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-server-transporte-13751000.database.windows.net"
		},
		"sql_dw_transporte_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dw_transporte"
		},
		"sql_dw_transporte_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "rebeca"
		},
		"sql_erp_transporte_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-server-transporte-13751000.database.windows.net"
		},
		"sql_erp_transporte_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "erp_transporte_db"
		},
		"sql_erp_transporte_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "rebeca"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/b_csv_rutas')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "sa_transporte",
					"type": "LinkedServiceReference"
				},
				"folder": {
					"name": "broze"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "rutas.csv",
						"folderPath": "datos_csv",
						"fileSystem": "raw"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "cod_ruta",
						"type": "String"
					},
					{
						"name": "nombre_ruta",
						"type": "String"
					},
					{
						"name": "origen",
						"type": "String"
					},
					{
						"name": "destino",
						"type": "String"
					},
					{
						"name": "fecha_desde",
						"type": "String"
					},
					{
						"name": "fecha_hasta",
						"type": "String"
					},
					{
						"name": "estado",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/sa_transporte')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/sa_transporte')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('sa_transporte_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('sa_transporte_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/sql_dw_transporte')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('sql_dw_transporte_properties_typeProperties_server')]",
					"database": "[parameters('sql_dw_transporte_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('sql_dw_transporte_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('sql_dw_transporte_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/sql_erp_transporte')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('sql_erp_transporte_properties_typeProperties_server')]",
					"database": "[parameters('sql_erp_transporte_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('sql_erp_transporte_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('sql_erp_transporte_password')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}